FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=0

WORKDIR /app

# Layer 1: install dependencies only — reruns only when pyproject.toml changes
COPY pyproject.toml README.md ./
RUN pip install --upgrade pip && \
    pip install hatchling && \
    pip install $(python -c "import tomllib; d=tomllib.load(open('pyproject.toml','rb')); print(' '.join(d['project']['dependencies']))")

# Layer 2: copy code, then register the package — reruns on src/ changes but deps layer stays cached
COPY src ./src
COPY configs ./configs
COPY deploy/healthcheck.sh /usr/local/bin/agent-healthcheck
RUN pip install -e . --no-deps && \
    chmod +x /usr/local/bin/agent-healthcheck && \
    mkdir -p /app/data/raw /app/data/normalised /app/data/account /app/data/derived /app/data/logs

ENTRYPOINT ["python", "-m", "polymarket_arb.cli"]

HEALTHCHECK --interval=60s --timeout=30s --start-period=60s --retries=3 \
  CMD /usr/local/bin/agent-healthcheck || exit 1
