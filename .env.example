# Phase 0–2: read-only research. No secrets are required to run healthcheck or
# fetch market/orderbook data. Variables below are placeholders for later
# phases. Copy this file to `.env` and edit. The .env file is gitignored.

# ─── Compliance / runtime environment ────────────────────────────────────────
POLYMARKET_ARB_ENV=dev
# Two independent egress-IP check providers (used by compliance/geo_check.py).
POLYMARKET_ARB_IP_PROVIDER_PRIMARY=https://api.ipify.org?format=json
POLYMARKET_ARB_IP_PROVIDER_SECONDARY=https://ifconfig.co/json

# ─── Trade gate ──────────────────────────────────────────────────────────────
# Must remain "false" for all of Phase 0–9. Flipping requires a signed git tag
# AND a separate manual one-shot token under data/.live_approved_<id>.
POLYMARKET_ARB_ORDERS_ALLOWED=false

# ─── Phase 3+ live agent (paper mode = default) ──────────────────────────────
# Paper mode is the safe default.  Flipping to live trading requires BOTH
# this flag AND POLYMARKET_ARB_ORDERS_ALLOWED=true above AND a real signing
# key below.  The OrderClient and the Docker healthcheck enforce this.
POLYMARKET_ARB_PAPER_MODE=true

# How often the agent polls the lake for fresh orderbook snapshots (seconds).
POLYMARKET_ARB_AGENT_POLL_INTERVAL_S=10

# Comma-separated token_id list the agent watches.  Empty / unset means the
# agent runs but has nothing to evaluate.  Fill this from a strategy preset.
POLYMARKET_ARB_WATCHED_TOKENS=

# Built-in strategy name to run inside the agent loop.  ``noop`` emits no
# intents and is the safe default for the first hours of VPS operation —
# verifies the loop, kill switch, and orders_log writer without any trades.
POLYMARKET_ARB_AGENT_STRATEGY=noop

# ─── Phase 10+ only: do NOT populate yet ─────────────────────────────────────
# POLYMARKET_PRIVATE_KEY=
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=
# POLYMARKET_ARB_POLYMARKET_FUNDER=
# POLYMARKET_ARB_POLYMARKET_SIGNATURE_TYPE=1
